| `:shared:core-domain` | `.core.domain` |
| `:shared:core-navigation` | `.core.navigation` |
| `:shared:core-network` | `.core.network` and `.core.network.ktor` |
| `:shared:core-mvikotlin` | `.core.mvikotlin` and `.core.mvikotlin.di` |
| `:shared:core-presentation` | `.core.presentation.viewmodel` |
| `:shared:core-storage` | `.core.storage` |
